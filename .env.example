# Generation backend: 'cli' (default) or 'api'
# cli — uses your existing Claude Code login, no API key needed
# api — uses the Anthropic SDK, requires ANTHROPIC_API_KEY below
TECHTIP_GEN_BACKEND=cli

# Required only when TECHTIP_GEN_BACKEND=api
# Never commit your real key — copy this file to .env and fill it in
# ANTHROPIC_API_KEY=your-key-here
