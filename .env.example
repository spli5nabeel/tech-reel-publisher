# Generation backend: 'cli' (default) or 'api'
# cli — uses your existing Claude Code login, no API key needed
# api — uses the Anthropic SDK, requires ANTHROPIC_API_KEY below
TECHTIP_GEN_BACKEND=cli

# Required only when TECHTIP_GEN_BACKEND=api
# Never commit your real key — copy this file to .env and fill it in
# ANTHROPIC_API_KEY=your-key-here

# Timeout in seconds for the CLI backend (default: 300)
# Increase if you see timeout errors on slow machines or networks
# TECHTIP_CLI_TIMEOUT=600

# TTS voice used when --tts flag is passed to main.py
# Run `edge-tts --list-voices` to see all available voices
# Male examples:   en-US-EricNeural, en-US-GuyNeural, en-GB-RyanNeural
# Female examples: en-US-JennyNeural, en-US-AriaNeural, en-GB-SoniaNeural
TECHTIP_TTS_VOICE=en-US-EricNeural
